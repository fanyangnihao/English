# Copy this file to /www/wwwroot/47.108.199.245/shared/.env and replace every value.
# Keep MINIO_ENDPOINT as a host name only. The backend adds the protocol and port.
NODE_ENV=production
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/english
AI_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/english
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SECRET_KEY=replace-with-a-long-random-secret

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=0
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=avatar
VITE_MINIO_ENDPOINT=47.108.199.245

EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USER=replace-me
EMAIL_PASSWORD=replace-me
EMAIL_FROM=English <no-reply@example.com>

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_REASONER_API_MODEL=deepseek-reasoner
BOCHA_SEARCH_URL=replace-me
BOCHA_API_KEY=replace-me

ALIPAY_APP_ID=replace-me
ALIPAY_PRIVATE_KEY=replace-me
ALIPAY_PUBLIC_KEY=replace-me
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=http://47.108.199.245
